{
  "$defs": {
    "StructuredFailure": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "failure_type": {
          "title": "Failure Type",
          "type": "string"
        },
        "symptom": {
          "default": "",
          "title": "Symptom",
          "type": "string"
        },
        "retry_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "step_id",
        "failure_type"
      ],
      "title": "StructuredFailure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "current_step": {
      "default": "intake",
      "title": "Current Step",
      "type": "string"
    },
    "completed_ids": {
      "items": {
        "type": "string"
      },
      "title": "Completed Ids",
      "type": "array"
    },
    "invalidated_ids": {
      "items": {
        "type": "string"
      },
      "title": "Invalidated Ids",
      "type": "array"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/StructuredFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "next_action": {
      "default": "collect_intake_answers",
      "title": "Next Action",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "StructuredExecutionState",
  "type": "object"
}
