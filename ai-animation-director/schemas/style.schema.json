{
  "$defs": {
    "ArtifactStatus": {
      "enum": [
        "not_started",
        "draft",
        "pending_review",
        "approved",
        "invalidated"
      ],
      "title": "ArtifactStatus",
      "type": "string"
    },
    "StageHandoff": {
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "items": {
            "type": "string"
          },
          "title": "Decisions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "invalidates": {
          "items": {
            "type": "string"
          },
          "title": "Invalidates",
          "type": "array"
        },
        "next_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "StageHandoff",
      "type": "object"
    },
    "StructuredStage": {
      "enum": [
        "intake",
        "blueprint_review",
        "concept",
        "style",
        "assets",
        "shots",
        "image_prompts",
        "video_prompts",
        "production",
        "complete"
      ],
      "title": "StructuredStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ArtifactStatus",
      "default": "not_started"
    },
    "source_references": {
      "items": {
        "type": "string"
      },
      "title": "Source References",
      "type": "array"
    },
    "palette": {
      "items": {
        "type": "string"
      },
      "title": "Palette",
      "type": "array"
    },
    "lighting": {
      "items": {
        "type": "string"
      },
      "title": "Lighting",
      "type": "array"
    },
    "spatial_layers": {
      "items": {
        "type": "string"
      },
      "title": "Spatial Layers",
      "type": "array"
    },
    "materials": {
      "items": {
        "type": "string"
      },
      "title": "Materials",
      "type": "array"
    },
    "composition": {
      "items": {
        "type": "string"
      },
      "title": "Composition",
      "type": "array"
    },
    "density": {
      "default": "",
      "title": "Density",
      "type": "string"
    },
    "prompt_anchors": {
      "items": {
        "type": "string"
      },
      "title": "Prompt Anchors",
      "type": "array"
    },
    "avoid": {
      "items": {
        "type": "string"
      },
      "title": "Avoid",
      "type": "array"
    },
    "handoff": {
      "$ref": "#/$defs/StageHandoff"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "StyleArtifact",
  "type": "object"
}
